<sitemesh>
    <!-- Không decorator (standalone pages) -->
    <mapping path="/views/login.jsp"              decorator="none"/>
    <mapping path="/views/register.jsp"           decorator="none"/>
    <mapping path="/views/verify-otp.jsp"         decorator="none"/>
    <mapping path="/views/forgot-password.jsp"    decorator="none"/>
    <mapping path="/views/verify-reset-otp.jsp"   decorator="none"/>
    <mapping path="/login"                        decorator="none"/>
    <mapping path="/register"                     decorator="none"/>
    <mapping path="/verify-otp"                   decorator="none"/>
    <mapping path="/forgot-password"              decorator="none"/>
    <mapping path="/verify-reset-otp"             decorator="none"/>
    <mapping path="/image*"                       decorator="none"/>
    <mapping path="/image/*"                      decorator="none"/>

    <!-- Decorator user (trang chủ + sản phẩm) -->
    <mapping path="/home"                         decorator="/decorators/default.jsp"/>
    <mapping path="/product"                      decorator="/decorators/default.jsp"/>
    <mapping path="/product-detail"               decorator="/decorators/default.jsp"/>
    <mapping path="/user/*"                       decorator="/decorators/default.jsp"/>
    <mapping path="/views/user/*"                 decorator="/decorators/default.jsp"/>
</sitemesh>
